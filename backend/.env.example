DATABASE_URL=postgresql+psycopg://lessonai:lessonai@localhost:5432/lessonai
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=["http://localhost:3000"]
AUTO_CREATE_TABLES=true
# ADMIN_EMAILS=["your-email@example.com"]

# AI моделҳо. Тартиби афзалият: 1 -> 2 -> 3 -> 4.
# Вақте лимити якум тамом шавад, худкор ба дуюм мегузарем (ва ғайра).
# Ҳар провайдер бояд се қимат дошта бошад (base_url, api_key, model), вагарна нодида гирифта мешавад.

# 1) Groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# 2) Google AI Studio (Gemini). Номи модели ройгонро аз aistudio.google.com санҷед
LLM2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM2_API_KEY=
LLM2_MODEL=gemini-2.5-flash

# 3) OpenRouter (модели бо :free дар охир)
LLM3_BASE_URL=https://openrouter.ai/api/v1
LLM3_API_KEY=
LLM3_MODEL=google/gemma-4-26b-a4b-it:free

# 4) (ихтиёрӣ) LLM4_BASE_URL, LLM4_API_KEY, LLM4_MODEL
